# MPCI-Bench Environment Variables
# Copy this file to .env and fill in your credentials.
# Never commit your .env file to version control.

# ── Azure OpenAI / Azure AI Foundry (required for GPT-4o / GPT-5 evaluation) ─
AZURE_OPENAI_KEY=your_azure_openai_api_key_here
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_API_VERSION=2024-02-15-preview
AZURE_DEPLOYMENT_NAME=your-deployment-name

# For OpenAI-compatible Azure AI Foundry deployments such as gpt-5.4, use:
# AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/openai/v1
# AZURE_DEPLOYMENT_NAME=gpt-5.4

# ── Mistral on Azure (optional — only needed for mistral-large-3) ───────────
MISTRAL_AZURE_API_KEY=your_mistral_azure_api_key_here
MISTRAL_AZURE_ENDPOINT=https://your-mistral-resource.openai.azure.com/openai/v1/

# ── xAI / Grok (optional — only needed for grok-3) ─────────────────────────
XAI_API_KEY=your_xai_api_key_here
GROK_ENDPOINT=https://api.x.ai/v1
